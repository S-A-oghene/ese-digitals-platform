{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "ese-digitals-platform",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://ese-digitals-platform.legaldept-nrc.workers.dev"
  },
  "ratelimits": [
    {
      "name": "OPPORTUNITY_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
